# =============================================================================
# AlfaWall Conversation API - Git Ignore
# =============================================================================
# This template repository encourages developers to customize application.yaml
# Therefore, application.yaml is NOT ignored (unlike typical Spring Boot projects)
# =============================================================================

# Maven build artifacts
target/
*.jar
*.war
*.ear
**/target/**

# IDE files
.idea/
*.iml
.vscode/
*.swp
*.swo
*~

# Logs
*.log

# OS files
.DS_Store
Thumbs.db

# Environment variables (contains API keys and secrets!)
.env
*.env

# IMPORTANT: application.yaml is NOT ignored
# Developers should customize it from application-example.yaml
# Keep example files in git for reference
!application-example.yaml
!.env.example

# Build artifacts
BOOT-INF/

# Claude Code local settings
.claude/settings.local.json

# Compiled class files
*.class

# Package files
*.zip
*.tar.gz
*.rar

# Test output
test-output/
.coverage

# Spring Boot DevTools
.spring-boot-devtools.properties
