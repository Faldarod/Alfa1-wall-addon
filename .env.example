# =============================================================================
# AlfaWall Conversation API - Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your actual values
# The .env file is git-ignored to keep secrets safe
#
# Usage: cp .env.example .env
# =============================================================================

# LLM Configuration (Required)
# Get your API key from OpenRouter (https://openrouter.ai) or OpenAI
OPENAI_API_KEY=your-api-key-here

# LLM API Endpoint (Optional)
# Default: OpenRouter (aggregates multiple LLM providers)
# Alternatives: https://api.openai.com/v1 (OpenAI direct)
#               http://localhost:11434/v1 (Ollama local)
SPRING_AI_OPENAI_BASE_URL=https://openrouter.ai/api/v1

# LLM Model Selection (Optional)
# Default: openai/gpt-4o-mini (via OpenRouter)
# Examples: gpt-4, claude-3-opus, llama2 (for Ollama)
SPRING_AI_OPENAI_CHAT_OPTIONS_MODEL=openai/gpt-4o-mini

# LLM Temperature (Optional)
# Default: 0.3 (more deterministic)
# Range: 0.0 (deterministic) to 1.0 (creative)
SPRING_AI_OPENAI_CHAT_OPTIONS_TEMPERATURE=0.3

# Embabel Default LLM (Optional)
# Must match model naming format expected by Embabel
EMBABEL_MODELS_DEFAULT_LLM=gpt-4.1-mini

# Home Assistant Configuration (Required for production)
# Get your token from Home Assistant:
# Profile → Long-Lived Access Tokens → Create Token
HOMEASSISTANT_BASE_URL=http://localhost:8123
HOMEASSISTANT_TOKEN=your-long-lived-access-token-here

# Feature Flags (Optional)
# Enable LLM-driven tool selection (set to false for keyword routing only)
ALFAWALL_LLM_TOOL_SELECTION_ENABLED=true

# LLM call timeout in milliseconds
ALFAWALL_LLM_TOOL_SELECTION_TIMEOUT_MS=5000

# Fall back to keyword routing if LLM fails (recommended: true)
ALFAWALL_LLM_TOOL_SELECTION_FALLBACK_ON_ERROR=true

# Log LLM performance metrics (execution time, tools used)
ALFAWALL_LLM_TOOL_SELECTION_LOG_PERFORMANCE=true
